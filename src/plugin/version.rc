#include <winres.h>

#define DD_STR2(x) #x
#define DD_STR(x) DD_STR2(x)

#if defined(DD_GAME_SKYRIM)
#    define DD_DESCRIPTION "Dump Diver - freeze diagnostics for Skyrim (SKSE plugin)"
#else
#    define DD_DESCRIPTION "Dump Diver - freeze diagnostics for Fallout 4 (F4SE plugin)"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION DD_VERSION_MAJOR, DD_VERSION_MINOR, DD_VERSION_PATCH, 0
PRODUCTVERSION DD_VERSION_MAJOR, DD_VERSION_MINOR, DD_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Asciimov"
            VALUE "FileDescription", DD_DESCRIPTION
            VALUE "FileVersion", DD_VERSION_STRING
            VALUE "InternalName", "DumpDiver"
            VALUE "OriginalFilename", "DumpDiver.dll"
            VALUE "ProductName", "Dump Diver"
            VALUE "ProductVersion", DD_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
