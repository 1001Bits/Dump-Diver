#include <winres.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION DD_VERSION_MAJOR, DD_VERSION_MINOR, DD_VERSION_PATCH, 0
PRODUCTVERSION DD_VERSION_MAJOR, DD_VERSION_MINOR, DD_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Asciimov"
            VALUE "FileDescription", "Dump Diver helper - watches the game and explains freezes"
            VALUE "FileVersion", DD_VERSION_STRING
            VALUE "InternalName", "DumpDiverHelper"
            VALUE "OriginalFilename", "DumpDiverHelper.exe"
            VALUE "ProductName", "Dump Diver"
            VALUE "ProductVersion", DD_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
